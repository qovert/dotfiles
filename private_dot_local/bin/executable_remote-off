#!/usr/bin/env bash
# Undo remote-on: bring the physical monitors back and drop the virtual output.
# Workspaces return to their assigned monitors. Bound to Super+Ctrl+Shift+R
# in case a session ends without Sunshine running this.
set -euo pipefail

state="${XDG_RUNTIME_DIR:-/tmp}/remote-outputs"

# Remove the reload overlay first so a reload from here on restores the monitors
rm -f "${XDG_RUNTIME_DIR:-/tmp}/sway-remote.conf"

# A monitor in deep standby can take a few seconds to wake, and enabling it
# meanwhile fails. Retry, and never stop early: an aborted run would leave
# the virtual output behind with workspaces stranded on it. Monitors that
# still fail come back on their own when they hotplug.
enable() {
    for _ in 1 2 3 4 5; do
        swaymsg output "$1" enable >/dev/null 2>&1 && return 0
        sleep 1
    done
    echo "remote-off: couldn't enable $1" >&2
}

if [[ -s $state ]]; then
    while read -r o; do enable "$o"; done < "$state"
else
    enable '*'
fi
rm -f "$state"

for o in $(swaymsg -rt get_outputs | jq -r '.[] | select(.name | startswith("HEADLESS-")) | .name'); do
    swaymsg output "$o" unplug >/dev/null || true
done
