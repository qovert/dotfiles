# sway config — managed by chezmoi
# Reload with $mod+Shift+c, check syntax with `sway -C`.

include /etc/sway/config.d/*

set $mod Mod4
# Windows come from ghostty's single instance (D-Bus activated), so they open fast
set $term ghostty +new-window
set $menu fuzzel
set $lock ~/.local/bin/lock-screen

# --- Outputs -----------------------------------------------------------------
# Per-machine monitors and workspace placement. The real file is git-ignored;
# copy config.d/outputs.example to config.d/outputs in the chezmoi source.
include ~/.config/sway/config.d/*
# Current slideshow image, written by wallpaper-rotate
include $XDG_RUNTIME_DIR/sway-wallpaper.conf
# Written by remote-on during a Moonlight session, removed by remote-off
include $XDG_RUNTIME_DIR/sway-remote.conf

# Tearing for fullscreen games that ask for it (lower input latency)
output * allow_tearing yes

# --- Look --------------------------------------------------------------------
font pango:Cantarell 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
smart_gaps on
smart_borders on
seat seat0 xcursor_theme Adwaita 24

# class                 border  bg      text    indicator child_border
client.focused          #89b4fa #89b4fa #1e1e2e #f5c2e7   #89b4fa
client.focused_inactive #45475a #45475a #cdd6f4 #45475a   #45475a
client.unfocused        #313244 #313244 #a6adc8 #313244   #313244

# Wallpaper slideshow from the same folder azwallpaper uses
exec ~/.local/bin/wallpaper-rotate
# terminal | Firefox | terminal on workspace 1, like the GNOME tiling layout
exec ~/.local/bin/layout-main 1

# --- Input -------------------------------------------------------------------
input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 40
}
input type:pointer accel_profile flat
focus_follows_mouse no

# --- Session -----------------------------------------------------------------
# Env export + sway-session.target come from /etc/sway/config.d (sway-systemd).
# ~/.config/autostart runs via a sway-session.target drop-in, since
# xdg-desktop-autostart.target refuses a manual start.
exec mako
exec lxqt-policykit-agent
exec nm-applet --indicator
exec blueman-applet
exec wl-paste --watch cliphist store

# Remote access over Tailscale: Moonlight (Sunshine) runs as a systemd user
# unit tied to sway-session.target, so it restarts if it dies. wayvnc is the
# clipboard-capable fallback; uncomment to use it.
# exec sh -c 'wayvnc "$(tailscale ip -4)"'

exec swayidle -w \
    timeout 600 '$lock' \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

bar {
    swaybar_command waybar
}

# --- Window rules ------------------------------------------------------------
for_window [window_type="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [app_id="pavucontrol|org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [class="1Password" title="Quick Access"] floating enable
for_window [app_id="1password" title="Quick Access"] floating enable
for_window [class="steam" title="^(Friends List|Steam Settings|Steam - News)"] floating enable

# Nothing fullscreen (games, video) ever gets blanked or locked
for_window [all] inhibit_idle fullscreen

# Games: own workspace. Tearing follows the game's own VSync setting
# (output * allow_tearing above permits it; a per-window "yes" would force it).
assign [class="steam_app_.*"] workspace number 10

# --- Keys: launch / session --------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec ~/.local/bin/toolbox-term
bindsym $mod+d exec $menu
bindsym $mod+space exec $menu
bindsym $mod+e exec nautilus
bindsym $mod+v exec sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'
bindsym Control+Shift+space exec 1password --quick-access
bindsym $mod+l exec $lock
bindsym Print exec sh -c 'grim -g "$(slurp)" - | wl-copy'
bindsym Shift+Print exec sh -c 'grim - | wl-copy'
bindsym $mod+Shift+c reload
# Lock / log out / suspend / restart / shut down
bindsym $mod+Shift+e exec ~/.local/bin/power-menu

# Get the physical monitors back if a remote session didn't clean up
bindsym $mod+Control+Shift+r exec ~/.local/bin/remote-off

# --- Keys: windows (kept close to your GNOME habits) -------------------------
bindsym $mod+q kill
bindsym Mod1+F4 kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Up fullscreen toggle
bindsym $mod+Shift+space floating toggle
# Super+left-drag moves windows (tiled too), Super+right-drag resizes
floating_modifier $mod normal
bindsym $mod+Tab workspace back_and_forth
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev

# Focus/move with Super(+Shift)+arrows; moving past an edge crosses monitors
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Control+Up focus up

# GNOME "minimize" (Super+h) -> scratchpad
bindsym $mod+h move scratchpad
bindsym $mod+minus scratchpad show

# Layouts: split direction, tabs/stacking, and your 22/56/22 columns
bindsym $mod+b splith
bindsym $mod+s splitv
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+a focus parent
bindsym $mod+c resize set width 56 ppt
bindsym $mod+x resize set width 22 ppt
# Build terminal | Firefox | terminal on the focused (empty) workspace
bindsym $mod+Shift+Home exec ~/.local/bin/layout-main

mode "resize" {
    bindsym Left resize shrink width 40px
    bindsym Right resize grow width 40px
    bindsym Up resize shrink height 40px
    bindsym Down resize grow height 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Keys: workspaces --------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Your existing GNOME workspace keys still work
bindsym $mod+Home workspace number 1
bindsym $mod+End workspace number 10
bindsym $mod+Page_Up workspace prev_on_output
bindsym $mod+Page_Down workspace next_on_output
bindsym $mod+Shift+Page_Up move container to workspace prev_on_output
bindsym $mod+Shift+Page_Down move container to workspace next_on_output

# --- Keys: media -------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
