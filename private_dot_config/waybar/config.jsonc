{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
  "modules-center": ["sway/window"],
  "modules-right": [
    "idle_inhibitor",
    "custom/tailscale",
    "cpu",
    "memory",
    "temperature",
    "custom/gpu",
    "pulseaudio",
    "clock",
    "tray"
  ],
  "sway/window": { "max-length": 80 },
  "sway/scratchpad": { "format": "SP {count}", "show-empty": false },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "☕", "deactivated": "💤" },
    "tooltip-format-activated": "Caffeine on: no idle lock",
    "tooltip-format-deactivated": "Caffeine off"
  },
  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale.sh",
    "return-type": "json",
    "interval": 15
  },
  "cpu": { "format": "CPU {usage}%", "interval": 3 },
  "memory": { "format": "RAM {used:0.0f}G", "interval": 5 },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "tooltip-format": "CPU Tctl {temperatureC}°C"
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 3
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "on-click": "pavucontrol"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": { "spacing": 8 }
}
